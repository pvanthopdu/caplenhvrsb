rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all (Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Deterministic, collision-free invite document ID from normalized lowercase email
    function emailToInviteId(email) {
      return email.lower().replace('_', '__').replace('@', '_at_').replace('\\.', '_dot_').replace('\\+', '_plus_');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Super Admins bootstrapped directly by verified Gmail identity
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email.lower() in ['hanh.atgt@gmail.com', 'pvantho@gmail.com'];
    }

    // Admin check (for single-document get/create/update/delete; never inside allow list)
    function isAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE'
      );
    }

    // Active assigned system user (blocks UNASSIGNED and LOCKED accounts from shared operational data)
    function isActiveSystemUser() {
      return isBootstrapAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'UNASSIGNED'
      );
    }

    // Config bucket editors (ADMIN or BP_CHIHUY for Border Guard unit config)
    function isConfigEditor() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'BP_CHIHUY'
      );
    }

    function isValidRole(role) {
      return role in [
        'UNASSIGNED',
        'ADMIN',
        'LEADER',
        'DEPT_HEAD',
        'OFFICER',
        'CLERK',
        'PORT_STAFF',
        'CAPTAIN',
        'DUTY_OFFICER',
        'VERIFIER',
        'BP_TRUC',
        'BP_CHIHUY'
      ];
    }

    function isValidSharedBucketId(bucketId) {
      return bucketId in [
        'trips',
        'catalog',
        'operations',
        'config',
        'bp_records',
        'kpi',
        'audit_logs'
      ];
    }

    function isValidUserDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'avatar',
          'phone',
          'department',
          'role',
          'status',
          'assignedVesselIds',
          'assignedPortId',
          'notes',
          'assignedByEmail',
          'assignedAt',
          'lastLogin',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150
        && isValidRole(data.role)
        && data.status in ['ACTIVE', 'LOCKED']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('department' in data) || (data.department is string && data.department.size() <= 200))
        && (!('assignedPortId' in data) || (data.assignedPortId is string && data.assignedPortId in ['', 'PORT-01', 'PORT-02']))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('assignedByEmail' in data) || (data.assignedByEmail is string && data.assignedByEmail.size() <= 200))
        && (!('assignedAt' in data) || (data.assignedAt is string && data.assignedAt.size() <= 64))
        && (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 64))
        && (!('assignedVesselIds' in data) || (
          data.assignedVesselIds is list &&
          data.assignedVesselIds.size() <= 10 &&
          (data.assignedVesselIds.size() == 0 || (data.assignedVesselIds[0] is string && data.assignedVesselIds[0].size() <= 64))
        ));
    }

    function isValidGmailInviteDoc(data) {
      return data.keys().hasAll(['id', 'email', 'fullName', 'role', 'status', 'assignedByEmail', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id',
          'email',
          'fullName',
          'phone',
          'department',
          'role',
          'status',
          'assignedVesselIds',
          'assignedPortId',
          'notes',
          'assignedByEmail',
          'assignedAt',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150
        && isValidRole(data.role)
        && data.status in ['ACTIVE', 'LOCKED']
        && data.assignedByEmail is string && data.assignedByEmail.size() >= 3 && data.assignedByEmail.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('department' in data) || (data.department is string && data.department.size() <= 200))
        && (!('assignedPortId' in data) || (data.assignedPortId is string && data.assignedPortId in ['', 'PORT-01', 'PORT-02']))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('assignedAt' in data) || (data.assignedAt is string && data.assignedAt.size() <= 64))
        && (!('assignedVesselIds' in data) || (
          data.assignedVesselIds is list &&
          data.assignedVesselIds.size() <= 10 &&
          (data.assignedVesselIds.size() == 0 || (data.assignedVesselIds[0] is string && data.assignedVesselIds[0].size() <= 64))
        ));
    }

    function isValidSharedStateBucket(data, bucketId) {
      return data.keys().hasAll([
          'bucketId',
          'schemaVersion',
          'revision',
          'clientWriteId',
          'updatedByUid',
          'updatedByEmail',
          'data',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'bucketId',
          'schemaVersion',
          'revision',
          'clientWriteId',
          'updatedByUid',
          'updatedByEmail',
          'data',
          'createdAt',
          'updatedAt'
        ])
        && data.bucketId is string
        && data.bucketId == bucketId
        && isValidSharedBucketId(data.bucketId)
        && data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 100
        && data.revision is int && data.revision >= 1 && data.revision <= 1000000000
        && data.clientWriteId is string && data.clientWriteId.size() >= 1 && data.clientWriteId.size() <= 128
        && isValidId(data.updatedByUid)
        && data.updatedByUid == request.auth.uid
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 200
        && data.updatedByEmail == request.auth.token.email.lower()
        && data.data is map
        && data.data.keys().size() <= 16
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function matchesPreAssignedInvite(data) {
      let inviteId = emailToInviteId(request.auth.token.email);
      let invitePath = /databases/$(database)/documents/gmail_invites/$(inviteId);
      return isValidId(inviteId)
        && exists(invitePath)
        && get(invitePath).data.email == request.auth.token.email.lower()
        && data.role == get(invitePath).data.role
        && data.status == get(invitePath).data.status
        && (!('assignedVesselIds' in get(invitePath).data) || data.assignedVesselIds == get(invitePath).data.assignedVesselIds)
        && (!('assignedPortId' in get(invitePath).data) || data.assignedPortId == get(invitePath).data.assignedPortId);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Secure list query: no get()/exists() lookups; non-admins can only list their own uid record
      allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.uid == request.auth.uid);

      // Users register themselves as UNASSIGNED on first Gmail login, or claim a verified admin-created Gmail invite
      allow create: if isValidId(userId)
        && isSignedIn()
        && isValidUserDoc(incoming())
        && userId == request.auth.uid
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email.lower()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isBootstrapAdmin() && incoming().role == 'ADMIN' && incoming().status == 'ACTIVE') ||
          (incoming().role == 'UNASSIGNED' && incoming().status == 'ACTIVE') ||
          matchesPreAssignedInvite(incoming())
        );

      allow update: if isValidId(userId)
        && isSignedIn()
        && isValidUserDoc(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'role', 'status', 'department', 'phone', 'assignedVesselIds',
              'assignedPortId', 'notes', 'assignedByEmail', 'assignedAt',
              'updatedAt', 'fullName', 'avatar', 'lastLogin'
            ])
          ) ||
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'avatar', 'lastLogin', 'updatedAt'])
          ) ||
          (
            request.auth.uid == userId &&
            existing().role == 'UNASSIGNED' &&
            matchesPreAssignedInvite(incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'role', 'status', 'department', 'phone', 'assignedVesselIds',
              'assignedPortId', 'notes', 'assignedByEmail', 'assignedAt',
              'fullName', 'avatar', 'lastLogin', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(userId)
        && isAdmin()
        && userId != request.auth.uid
        && !(existing().email.lower() in ['hanh.atgt@gmail.com', 'pvantho@gmail.com']);
    }

    match /gmail_invites/{inviteId} {
      // Only admins or the exact verified Gmail owner can fetch a pre-assignment invite
      allow get: if isValidId(inviteId)
        && isSignedIn()
        && (isAdmin() || inviteId == emailToInviteId(request.auth.token.email));

      // Secure list query: no get()/exists() lookups; non-admins can only list their own email
      allow list: if isSignedIn() && (
        isBootstrapAdmin() || resource.data.email == request.auth.token.email.lower()
      );

      allow create: if isValidId(inviteId)
        && isSignedIn()
        && isValidGmailInviteDoc(incoming())
        && incoming().id == inviteId
        && incoming().id == emailToInviteId(incoming().email)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isValidId(inviteId)
        && isSignedIn()
        && isValidGmailInviteDoc(incoming())
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'phone', 'department', 'role', 'status',
          'assignedVesselIds', 'assignedPortId', 'notes',
          'assignedByEmail', 'assignedAt', 'updatedAt'
        ]);

      // Admin can revoke anytime; verified Gmail owner can consume their invite after their users/{uid} exists
      allow delete: if isValidId(inviteId)
        && isSignedIn()
        && (
          isAdmin() ||
          (
            inviteId == emailToInviteId(request.auth.token.email) &&
            existing().email == request.auth.token.email.lower() &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
          )
        );
    }

    match /shared_state/{bucketId} {
      // No collection-wide list queries; clients attach directly to the 7 known bucket IDs
      allow list: if false;

      // Only verified, active, role-assigned system users can read shared operational buckets
      allow get: if isValidId(bucketId)
        && isValidSharedBucketId(bucketId)
        && isActiveSystemUser();

      // Seed initial bucket document (config bucket restricted to ADMIN / BP_CHIHUY)
      allow create: if isValidId(bucketId)
        && isSignedIn()
        && isValidSharedStateBucket(incoming(), bucketId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (bucketId == 'config' && isConfigEditor()) ||
          (bucketId != 'config' && isActiveSystemUser())
        );

      // Action-based update with strict key allowlist, immutable bucketId/createdAt, monotonic revision
      allow update: if isValidId(bucketId)
        && isSignedIn()
        && isValidSharedStateBucket(incoming(), bucketId)
        && incoming().bucketId == existing().bucketId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().revision >= existing().revision
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'schemaVersion',
          'revision',
          'clientWriteId',
          'updatedByUid',
          'updatedByEmail',
          'data',
          'updatedAt'
        ])
        && (
          isAdmin() ||
          (bucketId == 'config' && isConfigEditor()) ||
          (bucketId != 'config' && isActiveSystemUser())
        );

      // Only admins may delete a shared state bucket (e.g. during full reset)
      allow delete: if isValidId(bucketId)
        && isValidSharedBucketId(bucketId)
        && isAdmin();
    }

    match /test/{docId} {
      allow get: if isValidId(docId) && isSignedIn() && docId == 'connection';
      allow list, write: if false;
    }
  }
}
